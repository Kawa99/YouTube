# Required for YouTube Data API collection.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Flask/session configuration.
SECRET_KEY=change-this-in-real-environments
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Background jobs.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=channel-scrape
CHANNEL_JOB_TIMEOUT_SECONDS=7200
CHANNEL_JOB_RESULT_TTL_SECONDS=86400
TRACKED_CHANNEL_MAX_VIDEOS=50
VIDEO_SAVE_COMMIT_INTERVAL=50

# Database.
# Local non-Docker default is SQLite at ./data/videos.db when DATABASE_URL is unset.
# Docker Compose currently uses Postgres:
# DATABASE_URL=postgresql://baroo:baroo_pass@db:5432/baroo_db
DATABASE_URL=

# Research-engine roadmap flags. These are placeholders for later phases.
TRANSCRIPTS_ENABLED=false
TRANSCRIPT_FETCH_MODE=manual
RAW_PAYLOAD_STORAGE_ENABLED=false
DEFAULT_COLLECTION_MAX_VIDEOS=50
YOUTUBE_DAILY_QUOTA_BUDGET=10000
DERIVED_METRICS_ALGORITHM_VERSION=derived-metrics-v1
DERIVED_BREAKOUT_THRESHOLD=5
DERIVED_OUTLIER_THRESHOLD=2
DERIVED_UNDERPERFORMER_THRESHOLD=0.5
DERIVED_RECENT_VIDEO_LIMIT=20

# Owned-channel analytics OAuth metadata.
# Raw OAuth tokens must live in an external secret backend, not in this repo or database.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OWNED_ANALYTICS_TOKEN_SECRET_BACKEND=external

# Optional.
SENTRY_DSN=
SOCKETIO_ASYNC_MODE=threading
API_MAX_RETRIES=5
API_BACKOFF_BASE_SECONDS=0.5
